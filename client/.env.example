# Backend API base URL (must include /api)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Socket.IO server URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Optional: only needed if you use Paystack InlineJS. The cashier uses a
# server-created checkout redirect and does not require this key.
NEXT_PUBLIC_PAYSTACK_KEY=

NEXT_PUBLIC_APP_NAME=Spotibet Casino & Aviator
