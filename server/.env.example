# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
# Comma-separated additional origins allowed by CORS
# CORS_ORIGINS=https://www.example.com

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- Database ---
# The app currently uses local SQLite (see server/prisma.config.ts and src/config/db.ts).
# DATABASE_URL is unused until the Prisma datasource is migrated to PostgreSQL.

# --- Paystack ---
# Test and live secret keys both work. Never commit real keys.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# --- Payments ---
DEFAULT_CURRENCY=KES
MIN_DEPOSIT=100
MAX_DEPOSIT=500000
MIN_WITHDRAWAL=100
MAX_WITHDRAWAL=500000

# Local-only instant top-up endpoint. Automatically disabled in production.
ENABLE_DEV_DEPOSIT=true

# --- Games ---
HOUSE_EDGE=0.04
MAX_BET=500000
MIN_BET=100
MAX_CASHOUT_MULTIPLIER=1000
